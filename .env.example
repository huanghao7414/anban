# Copy to .env. Keep credentials on the server only.
ANBAN_AGENT_ENGINE=dsh
ANBAN_CHAT_PROVIDER=glm
ANBAN_VISION_PROVIDER=glm
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ANBAN_CHAT_MODEL=glm-4.7
ANBAN_VISION_MODEL=glm-4.6v
# Optional per-task overrides; keys never fall back to another provider.
# ANBAN_CHAT_API_KEY=
# ANBAN_VISION_API_KEY=
# ANBAN_CHAT_BASE_URL=
# ANBAN_VISION_BASE_URL=
# DeepSeek remains available by choosing provider=deepseek and its model names.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DSH uses DeepSeek's Anthropic-compatible endpoint; direct uses Chat Completions.
ANBAN_DSH_BASE_URL=https://api.deepseek.com/anthropic
ANBAN_TTS=auto
ANBAN_DATA_DIR=.run/health
ANBAN_TIMEZONE=Asia/Shanghai
# Optional font for server-rendered Chinese PNG cards on Linux.
ANBAN_FONT_PATH=

# Optional Qwen speech for scheduled web reminders.
ANBAN_REMINDER_TTS_API_KEY=
ANBAN_REMINDER_TTS_URL=https://maas.qianwenaiapi.com/api/v1/services/audio/tts/SpeechSynthesizer
ANBAN_REMINDER_TTS_MODEL=qwen-audio-3.1-tts-flash
ANBAN_REMINDER_TTS_VOICE=longanhuan_v3.1
